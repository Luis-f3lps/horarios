generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// TABELAS DO SISTEMA DE HORÁRIOS - IFNMG
// ==========================================

model Professor {
  id              Int          @id @default(autoincrement())
  nome            String
  diasDisponiveis Json         // Formato: {"segunda": ["M1", "M2"], "terca": []}
  disciplinas     Disciplina[]
}

model Turma {
  id          Int          @id @default(autoincrement())
  nome        String       @unique
  disciplinas Disciplina[]
}

model Disciplina {
  id    Int    @id @default(autoincrement())
  nome  String
  setor String // 'tecnico' ou 'graduacao'
  
  // Relacionamento com professor
  professorId Int
  professor   Professor @relation(fields: [professorId], references: [id])
  
  // Relacionamento com turmas (Muitos para Muitos)
  turmas      Turma[]
  
  // Campo auxiliar para a regra de "Turma Inexistente"
  turmasPermitidas Int[] // IDs das turmas que podem cursar esta disciplina
}

model AulaSalva {
  id           Int    @id @default(autoincrement())
  professorId  Int
  turmaId      Int
  disciplinaId Int
  dia          String
  turno        String
  setor        String
}

model RegraPedagogica {
  id         Int    @id @default(autoincrement())
  nome       String
  valorMax   Int
  penalidade Int
}